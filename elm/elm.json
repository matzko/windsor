{
    "type": "package",
    "name": "matzko/windsor",
    "summary": "A backend framework for Elm",
    "license": "MIT",
    "version": "1.0.0",
    "exposed-modules": [
        "Windsor",
        "Windsor.Conn",
        "Windsor.Request",
        "Windsor.Router",
        "Windsor.Plug",
        "Windsor.View",
        "Windsor.Error",
        "Windsor.Task"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "andrewMacmurray/elm-concurrent-task": "2.0.0 <= v < 3.0.0",
        "elm/core": "1.0.5 <= v < 2.0.0",
        "elm/json": "1.1.4 <= v < 2.0.0",
        "elm/url": "1.0.0 <= v < 2.0.0",
        "zwilias/elm-html-string": "2.0.2 <= v < 3.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.2.1 <= v < 3.0.0"
    }
